DATABASE_URL="postgresql://postgres:postgres@localhost:5432/derclinic"
# Dawny wspólny sekret — nadal wymagany jako zapasowe źródło kluczy, dopóki nie
# ustawisz osobnych kluczy poniżej.
AUTH_SECRET="change-me-to-a-long-random-secret"

# Osobne, losowe klucze dla osobnych domen zaufania (audyt bezpieczeństwa F-08).
# Każdy min. 32 znaki. Wygeneruj np.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Zmiana jednego klucza nie wpływa na pozostałe:
#  * STAFF_AUTH_SECRET   — sesje personelu (zmiana = wylogowanie personelu),
#  * PATIENT_AUTH_SECRET — sesje pacjentów (zmiana = wylogowanie pacjentów),
#  * MFA_ENCRYPTION_KEY  — szyfrowanie sekretów 2FA (NIE zmieniaj bez ustawienia
#                          poprzedniej wartości w MFA_ENCRYPTION_KEY_PREVIOUS),
#  * DATA_ENCRYPTION_KEY — szyfrowanie zdjęć z wizyt i notatek (jak wyżej:
#                          przy rotacji stara wartość do DATA_ENCRYPTION_KEY_PREVIOUS),
#  * AUDIT_SIGNING_KEY   — podpis wpisów dziennika zdarzeń.
STAFF_AUTH_SECRET=""
PATIENT_AUTH_SECRET=""
MFA_ENCRYPTION_KEY=""
MFA_ENCRYPTION_KEY_PREVIOUS=""
DATA_ENCRYPTION_KEY=""
DATA_ENCRYPTION_KEY_PREVIOUS=""
# Opcjonalny osobny klucz indeksów ślepych (skróty do wyszukiwania zaszyfrowanych danych pacjenta).
# Gdy pusty, jest wyprowadzany z DATA_ENCRYPTION_KEY. Zmiana = przeliczenie skrótów (Bezpieczeństwo konta).
BLIND_INDEX_KEY=""
AUDIT_SIGNING_KEY=""

# Wysyłka e-maili przez Resend (https://resend.com): potwierdzenia i
# przypomnienia o wizytach, powiadomienia dla personelu, reset hasła. Bez tych
# dwóch zmiennych nic nie zostanie wysłane (aplikacja działa dalej, a próby
# widać w panelu admina → Poczta e-mail). Adres nadawcy musi być
# w domenie zweryfikowanej w Resend (rekordy DNS). Które wiadomości są
# włączone i kto dostaje powiadomienia, ustawia się już w panelu admina.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="DerClinic <no-reply@mail.derclinic.pl>"

# Sekret dla zadań cyklicznych Vercel Cron (codzienne przypomnienia o
# wizytach, harmonogram w vercel.json). Dowolny losowy ciąg, min. 16 znaków —
# Vercel sam dołącza go do wywołań. Bez niego automatyczne przypomnienia nie
# działają (można je wtedy wysyłać ręcznie z panelu admina).
CRON_SECRET=""

# Logowanie pacjentów przez Google (panel klienta i rezerwacja online).
# Bez tych dwóch zmiennych przycisk "Kontynuuj z Google" po prostu się nie pokazuje.
# Google Cloud Console → APIs & Services → Credentials → Create credentials →
# OAuth client ID (Web application). W "Authorized redirect URIs" dodaj:
#   https://<adres-aplikacji>/api/patient/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Logowanie pacjentów przez Facebooka (panel klienta i rezerwacja online).
# Bez tych dwóch zmiennych przycisk "Kontynuuj z Facebookiem" się nie pokazuje.
# developers.facebook.com → Moje aplikacje → Utwórz aplikację (przypadek użycia:
# uwierzytelnianie / "Facebook Login") → Ustawienia → Podstawowe: identyfikator
# i tajny klucz aplikacji. W "Facebook Login → Ustawienia → Prawidłowe
# identyfikatory URI przekierowania OAuth" dodaj:
#   https://<adres-aplikacji>/api/patient/facebook/callback
# Aplikacja musi być w trybie "Live", a uprawnienie "email" mieć dostęp
# zaawansowany — inaczej zalogują się tylko osoby z rolą w aplikacji.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Adres, pod którym działa aplikacja — używany do budowania linków w
# wiadomościach e-mail. Jeśli pominięty, użyty zostanie adres, z którego
# przyszło żądanie (zwykle wystarczy to nie ustawiać).
NEXT_PUBLIC_APP_URL=""
