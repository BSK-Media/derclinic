DATABASE_URL="postgresql://postgres:postgres@localhost:5432/derclinic"
# Dawny wspólny sekret — nadal wymagany jako zapasowe źródło kluczy, dopóki nie
# ustawisz osobnych kluczy poniżej.
AUTH_SECRET="change-me-to-a-long-random-secret"

# Osobne, losowe klucze dla osobnych domen zaufania (audyt bezpieczeństwa F-08).
# Każdy min. 32 znaki. Wygeneruj np.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Zmiana jednego klucza nie wpływa na pozostałe:
#  * STAFF_AUTH_SECRET   — sesje personelu (zmiana = wylogowanie personelu),
#  * PATIENT_AUTH_SECRET — sesje pacjentów (zmiana = wylogowanie pacjentów),
#  * MFA_ENCRYPTION_KEY  — szyfrowanie sekretów 2FA (NIE zmieniaj bez ustawienia
#                          poprzedniej wartości w MFA_ENCRYPTION_KEY_PREVIOUS),
#  * DATA_ENCRYPTION_KEY — szyfrowanie zdjęć z wizyt i notatek (jak wyżej:
#                          przy rotacji stara wartość do DATA_ENCRYPTION_KEY_PREVIOUS),
#  * AUDIT_SIGNING_KEY   — podpis wpisów dziennika zdarzeń.
STAFF_AUTH_SECRET=""
PATIENT_AUTH_SECRET=""
MFA_ENCRYPTION_KEY=""
MFA_ENCRYPTION_KEY_PREVIOUS=""
DATA_ENCRYPTION_KEY=""
DATA_ENCRYPTION_KEY_PREVIOUS=""
AUDIT_SIGNING_KEY=""

# Wysyłka e-maili transakcyjnych (obecnie: reset hasła pacjenta) przez Resend
# (https://resend.com — konto darmowe wystarczy na start). Bez tych dwóch
# zmiennych link do resetu hasła nie zostanie wysłany (funkcja nie wywali się,
# ale w logach serwera pojawi się ostrzeżenie).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="DerClinic <no-reply@derclinic.pl>"

# Logowanie pacjentów przez Google (panel klienta i rezerwacja online).
# Bez tych dwóch zmiennych przycisk "Kontynuuj z Google" po prostu się nie pokazuje.
# Google Cloud Console → APIs & Services → Credentials → Create credentials →
# OAuth client ID (Web application). W "Authorized redirect URIs" dodaj:
#   https://<adres-aplikacji>/api/patient/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Adres, pod którym działa aplikacja — używany do budowania linku w mailu do
# resetu hasła. Jeśli pominięty, użyty zostanie adres, z którego przyszło
# żądanie (zwykle wystarczy to nie ustawiać).
NEXT_PUBLIC_APP_URL=""
